# ==============================================================================
# AutoCutClips — Environment Variables
# ==============================================================================
# Copy this file to `.env` and fill in your API keys:
#   cp .env.sample .env
# ==============================================================================

# [REQUIRED] Google Gemini API Key
# Get yours at: https://aistudio.google.com/apikey
GOOGLE_API_KEY=your-gemini-api-key-here

# [OPTIONAL] Pexels API Key — needed for B-roll stock footage
# Get yours at: https://www.pexels.com/api/
PEXELS_API_KEY=your-pexels-api-key-here

# [OPTIONAL] HuggingFace Token — needed for split-screen mode (Pyannote speaker diarization)
# Get yours at: https://huggingface.co/settings/tokens
# You must also accept the model agreement: https://huggingface.co/pyannote/speaker-diarization-3.1
HF_TOKEN=your-hf-token-here


# [REQUIRED IF USING NVIDIA Provider]
# Get yours at: https://build.nvidia.com/
NVIDIA_API_KEY=your-nvidia-api-key-here

# [REQUIRED IF USING upload-instagram] Instagram Business account details
# Get IG_USER_ID and an access token via the Meta Graph API / Meta Business Suite.
IG_USER_ID=your-instagram-business-user-id
IG_ACCESS_TOKEN=your-instagram-access-token

# [OPTIONAL] Public base URL used to build a publicly reachable video URL for
# Instagram's Graph API upload (IG_ACCESS_TOKEN falls back to
# META_PAGE_ACCESS_TOKEN below if unset).
IG_PUBLIC_BASE_URL=https://your-public-host.example.com
IG_GRAPH_VERSION=v25.0

# [OPTIONAL] Legacy Facebook/Meta Page credentials — META_PAGE_ACCESS_TOKEN is
# accepted as a fallback for IG_ACCESS_TOKEN, and META_GRAPH_VERSION as a
# fallback for IG_GRAPH_VERSION.
META_PAGE_ACCESS_TOKEN=your-meta-api-key-here
META_GRAPH_VERSION=v25.0

# [OPTIONAL] Default timezone used by upload-youtube / upload-instagram scheduling
APP_TIMEZONE=Asia/Jakarta